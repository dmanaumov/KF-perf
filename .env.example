# Только инфраструктура. Ключи сервисов (Yandex Search API, Google Ads, AI-движки)
# и интервалы обновления задаёт лидер Performance в интерфейсе: «Сервисы и ключи».
# Доступы клиентов — в проекте → «Каналы и данные».

# ---------- База ----------
POSTGRES_DB=perf
POSTGRES_USER=perf
POSTGRES_PASSWORD=
# Для запуска без docker-compose:
# DATABASE_URL=postgres://perf:пароль@localhost:5432/perf

# Ключ шифрования всех токенов в БД (openssl rand -hex 24). НЕ МЕНЯТЬ после запуска.
APP_SECRET=

PUBLIC_URL=https://perf.kontentferma.com
COOKIE_SECURE=true
TZ=Europe/Moscow

# ---------- Вход через Mattermost ----------
MATTERMOST_URL=https://messager.kontentferma.com
# Сразу админы (через запятую). Пусто — админом станет первый вошедший.
ADMIN_EMAILS=
# CEO (как в KF Approval) — тоже админ; email должен совпадать с email в профиле Mattermost
CEO_EMAILS=
ADMIN_LOGINS=
# Роли из my.kontentferma: CEO → админ, лидеры направления Performance → руководитель.
# KF_MY_API_KEY = INGEST_API_KEY из Environment сервиса my.kontentferma.
KF_MY_URL=https://my.kontentferma.com
KF_MY_API_KEY=
KF_MY_DIRECTION=PERF
# Аварийный вход логином "admin" (пусто — выключен)
LOCAL_ADMIN_PASSWORD=

# ---------- Автоматизация ----------
SCHEDULER_ENABLED=true
# Для n8n: POST /api/cron/{sync,seo,geo}, заголовок X-Api-Key
AUTOMATION_API_KEY=

# Демо-данные в пустой БД (true только для показа на первом старте)
SEED_DEMO=false
