# ---------- База ----------
POSTGRES_DB=perf
POSTGRES_USER=perf
POSTGRES_PASSWORD=сменить-на-длинный-пароль
# Для запуска без docker-compose:
# DATABASE_URL=postgres://perf:пароль@localhost:5432/perf

# Ключ шифрования токенов рекламных кабинетов (openssl rand -hex 32).
# НЕ МЕНЯТЬ после запуска — сохранённые доступы перестанут расшифровываться.
APP_SECRET=

PUBLIC_URL=https://perf.kontentferma.com
COOKIE_SECURE=true

# ---------- Вход команды через Mattermost ----------
MATTERMOST_URL=https://messager.kontentferma.com
# Кто сразу админ (через запятую). Если пусто — админом станет первый вошедший.
ADMIN_EMAILS=dmitryanaumov@gmail.com
ADMIN_LOGINS=
# Аварийный вход логином "admin", если Mattermost недоступен (пусто — выключен)
LOCAL_ADMIN_PASSWORD=

# ---------- Автообновление ----------
SCHEDULER_ENABLED=true
SYNC_INTERVAL_HOURS=6
SYNC_LOOKBACK_DAYS=7
SYNC_INITIAL_DAYS=90
SEO_INTERVAL_HOURS=24
SEO_DEPTH=50
GEO_INTERVAL_DAYS=7
# Ключ для POST /api/cron/{sync,seo,geo} из n8n (заголовок X-Api-Key)
AUTOMATION_API_KEY=

# ---------- SEO: Yandex Search API (как в PR-мониторинге) ----------
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=

# ---------- Google Ads (общие для всех клиентов) ----------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_API_VERSION=v21
META_API_VERSION=v21.0

# ---------- GEO: AI-движки (движок включается, если задан ключ) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_WEB_SEARCH=true
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
DEEPSEEK_API_KEY=
# YandexGPT: по умолчанию берёт ключ/каталог Yandex Search API (нужна роль ai.languageModels.user)
YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=
YANDEXGPT_MODEL=yandexgpt/latest

# Демо-данные в пустой БД — для показа до подключения кабинетов
SEED_DEMO=false
